{
  "manifest_version": 3,
  "name": "Meeting Copilot",
  "version": "0.1.0",
  "description": "Real-time transcription and AI-suggested answers for Google Meet and Microsoft Teams (web). User-started, visible capture only.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "system.display"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Copilot",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png",
      "48": "icons/idle48.png",
      "128": "icons/idle128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Start or stop listening to the current tab"
    },
    "generate-answer": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Generate a suggested answer from the latest speech"
    }
  }
}
