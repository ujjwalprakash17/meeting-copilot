# Meeting Copilot server configuration.
# Copy to server/.env (or the repo root .env) and fill in real values. Never commit real keys.
# The extension never sees these values: all provider calls go through this local server.

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Comma-separated Chrome extension IDs allowed to connect (from chrome://extensions).
# Empty = any chrome-extension:// origin (convenient for local development).
ALLOWED_EXTENSION_IDS=
# Allow requests without an Origin header (CLI tools). Keep false normally.
ALLOW_NO_ORIGIN=false
LOG_LEVEL=info
# Logs transcript text at debug level. Off by default for privacy.
LOG_TRANSCRIPTS=false

# --- Speech-to-text (streaming) -------------------------------------------------
# Deepgram live streaming API: https://developers.deepgram.com/reference/speech-to-text/listen-streaming
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=replace_with_your_deepgram_key
DEEPGRAM_MODEL=nova-3
# Silence (ms) before Deepgram finalizes speech, and before it emits UtteranceEnd.
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# --- LLM (answer generation) -------------------------------------------------------
# groq = real answers via the Groq API; mock = labelled offline test output.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_key
# Must be a model your Groq account currently offers: https://console.groq.com/docs/models
# (llama-3.3-70b-versatile and llama-3.1-8b-instant were retired for free/developer accounts on 2026-08-16.)
# `npm run check:keys -w server` lists the models your key can use.
# The server checks this against Groq's live /models list at startup and logs a warning if it's missing.
GROQ_MODEL=openai/gpt-oss-120b
# Small fast model used only to confirm ambiguous question candidates. Set empty to disable.
GROQ_DETECTION_MODEL=openai/gpt-oss-20b
# Optional reasoning_effort for reasoning models. openai/gpt-oss-* models default to "low" (and no streamed
# reasoning) to keep time to first token short; other models only receive it when set here.
GROQ_REASONING_EFFORT=
LLM_TIMEOUT_MS=30000
# Upper bound; each answer is additionally capped by its length setting (short 220, medium 400, long 700).
LLM_MAX_ANSWER_TOKENS=700

# --- Question detection --------------------------------------------------------------
# Wait this long after the last finalized segment (without an end-of-speech signal) before evaluating.
QUESTION_DEBOUNCE_MS=1200
# Near-identical questions inside this window are answered only once.
QUESTION_DEDUPE_WINDOW_MS=120000

# --- Latency -------------------------------------------------------------------------
# Start a TENTATIVE answer from the interim transcript as soon as a clear, complete question appears.
# The final transcript confirms it (label removed) or retracts it (answer discarded). Saves the
# endpointing wait (~300 ms or more) at the cost of occasional discarded requests.
SPECULATIVE_ANSWERS=true
# Minimum heuristic question score for a tentative answer (2 = same bar as a normal question).
SPECULATION_MIN_SCORE=2
# Deadline for the optional ambiguous-question classifier (GROQ_DETECTION_MODEL); clear questions never use it.
CLASSIFIER_TIMEOUT_MS=1500
# A short fragment within this window after a question that is still being answered is merged into it.
CONTINUATION_WINDOW_MS=2000

# --- Conversation history (local SQLite) ---------------------------------------------
# Saves question/answer cards (never audio, transcripts or resume text) for the History tab.
HISTORY_ENABLED=true
# Default: server/data/history.sqlite (git-ignored). Use an absolute path to keep it elsewhere.
HISTORY_DB_PATH=

# --- Simulation mode ---------------------------------------------------------------------
# Speed multiplier for the scripted test transcript (1 = real time).
SIMULATION_SPEED=1
