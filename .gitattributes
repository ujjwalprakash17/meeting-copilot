# Keep line endings identical in every checkout, whatever core.autocrlf is set to. Prompts and other
# multi-line strings live in template literals, so CRLF in a checkout would change their text.
* text=auto eol=lf

# Windows launchers keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.wav binary
