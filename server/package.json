{
  "name": "@meeting-copilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:latency": "tsx bench/latency.ts",
    "bench:network": "tsx bench/network.ts",
    "smoke": "node scripts/smoke.mjs",
    "check:keys": "tsx scripts/check-keys.mjs",
    "bench:groq": "tsx bench/groq.ts",
    "bench:stt": "tsx bench/stt.ts",
    "bench:e2e": "tsx bench/e2e-real.ts",
    "bench:detection": "tsx bench/detection.ts"
  },
  "dependencies": {
    "@meeting-copilot/shared": "*",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.13.0",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
